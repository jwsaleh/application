<div class="page">


<header>
  <div class="brand">
    <svg class="wifi-logo" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="19" r="1.6" fill="#8FD3FF"/>
      <path d="M7 15.2a7 7 0 0 1 10 0" stroke="#4C8DFF" stroke-width="2" fill="none" stroke-linecap="round"/>
      <path d="M3.5 11.2a12 12 0 0 1 17 0" stroke="#4C8DFF" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.75"/>
      <path d="M0.5 7.4a16.5 16.5 0 0 1 23 0" stroke="#4C8DFF" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.45"/>
    </svg>
  </div>
  <a class="login-link" id="openLogin" href="https://formspree.io/login" target="_blank" rel="noopener">View applications</a>
</header>

<section class="hero">
  <div class="eyebrow"><span class="dot"></span> FIBER OPTIC SALES</div>
  <h1>Sell the fastest connection on the block.</h1>
  <p>We're hiring door-to-door reps to bring fiber wifi to new neighborhoods. Uncapped commission, your own territory, and a start date within days — not weeks.</p>
  <div class="cta-row">
    <button class="btn" onclick="document.getElementById('apply').scrollIntoView()">Apply now</button>
  </div>
  <div class="signal" aria-hidden="true"></div>
</section>

<section class="steps" id="how">
  <div class="steps-head">
    <h2 style="font-size:26px;">How it works</h2>
    <span class="mono" style="font-size:12px;color:var(--ink-soft);">FOUR STEPS · NO EXPERIENCE REQUIRED</span>
  </div>
  <div class="steps-grid">
    <div class="step"><div class="num">01</div><h3>Apply</h3><p>Send your name, number, and resume. Takes about two minutes.</p></div>
    <div class="step"><div class="num">02</div><h3>Interview</h3><p>A quick call to begin your onboarding process.</p></div>
    <div class="step"><div class="num">03</div><h3>Train</h3><p>Shadow a senior rep and learn the pitch, the product, and the route.</p></div>
    <div class="step"><div class="num">04</div><h3>Own your route</h3><p>Get your territory and start knocking. Most reps close their first week.</p></div>
  </div>
</section>

<section class="form-section" id="apply">
  <div class="form-card">
    <div id="formWrap">
      <h2>Apply to join</h2>
      <p>Fields marked with * are required.</p>
      <form id="appForm" novalidate>
        <div class="field">
          <label for="fullName">Full name *</label>
          <input type="text" id="fullName" name="fullName" required>
        </div>
        <div class="row2">
          <div class="field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="field">
            <label for="phone">Phone *</label>
            <input type="tel" id="phone" name="phone" required>
          </div>
        </div>
        <div class="field">
          <label for="city">Home town *</label>
          <input type="text" id="city" name="homeTown" required>
        </div>
        <div class="field">
          <label for="resumeInput">Resume (PDF) *</label>
          <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Upload resume PDF">
            <p><span class="browse">Click to upload</span> or drag a PDF here</p>
