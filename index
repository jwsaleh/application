<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#14171C">
<title>Join the Crew — Field Rep Application</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#14171C;
    --surface:#1D222A;
    --ink:#F2F5F8;
    --ink-soft:#B7C1D1;
    --line:#2C323C;
    --accent:#4C8DFF;
    --accent-2:#8FD3FF;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;color-scheme:dark !important;background:#14171C !important;background-color:#14171C !important;}
  body{
    margin:0;
    background:#14171C !important;
    background-color:#14171C !important;
    color:var(--ink) !important;
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  h1,h2,h3{font-family:'Space Grotesk',sans-serif;margin:0;letter-spacing:-0.01em;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--accent);
    display:flex;align-items:center;gap:8px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--accent-2);box-shadow:0 0 0 3px rgba(143,211,255,0.18), 0 0 8px rgba(143,211,255,0.5);}
  a{color:inherit;}

  /* header */
  header{
    display:flex;justify-content:space-between;align-items:center;
    padding:22px 6vw;
    max-width:1200px;margin:0 auto;
  }
  .brand{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;display:flex;align-items:center;gap:10px;}
  .wifi-logo{display:block;filter:drop-shadow(0 0 5px rgba(76,141,255,0.85)) drop-shadow(0 0 12px rgba(143,211,255,0.55));animation:wifiPulse 3.6s ease-in-out infinite;}
  @keyframes wifiPulse{
    0%,100%{filter:drop-shadow(0 0 5px rgba(76,141,255,0.85)) drop-shadow(0 0 12px rgba(143,211,255,0.55));}
    50%{filter:drop-shadow(0 0 8px rgba(76,141,255,1)) drop-shadow(0 0 18px rgba(143,211,255,0.75));}
  }
  @media (prefers-reduced-motion: reduce){.wifi-logo{animation:none;}}
  .login-link{font-size:13px;color:var(--ink-soft);text-decoration:none;border:1px solid var(--line);padding:8px 14px;border-radius:100px;background:var(--surface);cursor:pointer;transition:border-color .15s ease, color .15s ease, box-shadow .15s ease;}
  .login-link:hover{border-color:var(--accent);color:var(--accent-2);box-shadow:0 0 16px rgba(76,141,255,0.35);}

  /* hero */
  .hero{max-width:1200px;margin:0 auto;padding:60px 6vw 40px;position:relative;}

  /* full-page background bundle */
  .bg-fiber{
    position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;opacity:0.5;
  }
  .bg-fiber svg{width:100%;height:100%;display:block;}
  .bgspark{animation:bgtwinkle ease-in-out infinite;}
  @keyframes bgtwinkle{0%,100%{opacity:.35;}50%{opacity:1;}}
  @media (prefers-reduced-motion: reduce){.bgspark{animation:none;opacity:.7;}}
  .page{position:relative;z-index:1;}
  .hero h1{font-size:clamp(34px,5.5vw,58px);line-height:1.05;max-width:14ch;margin-top:18px;}
  .hero p{color:var(--ink-soft);font-size:17px;max-width:46ch;margin-top:18px;line-height:1.6;}
  .cta-row{margin-top:32px;display:flex;gap:14px;flex-wrap:wrap;}
  .btn{
    font-family:'Inter',sans-serif;font-weight:600;font-size:15px;
    padding:14px 26px;border-radius:100px;border:none;cursor:pointer;
    background:linear-gradient(135deg,var(--accent),#3B6FE0);color:#fff;
    box-shadow:0 0 0 rgba(76,141,255,0);
    transition:transform .15s ease, box-shadow .2s ease;
  }
  .btn:hover{transform:translateY(-1px);box-shadow:0 0 24px rgba(76,141,255,0.55), 0 8px 20px rgba(0,0,0,0.35);}
  .btn:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, .dropzone:focus-visible{
    outline:2px solid var(--accent-2); outline-offset:2px;
  }
  .btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--line);}

  /* signal line — signature element */
  .signal{
    position:relative;height:2px;background:var(--line);margin:44px 0 0;overflow:hidden;border-radius:2px;
  }
  .signal::before{
    content:'';position:absolute;top:50%;left:-40px;width:40px;height:40px;transform:translateY(-50%);
    background:radial-gradient(circle,rgba(76,141,255,0.45),transparent 70%);
    animation:pulse 3.2s linear infinite;
  }
  .signal::after{
    content:'';position:absolute;top:50%;left:-4px;width:8px;height:8px;border-radius:50%;transform:translateY(-50%);
    background:var(--accent-2);box-shadow:0 0 16px 3px rgba(143,211,255,0.7);
    animation:pulse 3.2s linear infinite;
  }
  @keyframes pulse{ 0%{left:-4px;} 100%{left:100%;} }
  @media (prefers-reduced-motion: reduce){
    .signal::before,.signal::after{animation:none;display:none;}
  }

  /* steps */
  .steps{max-width:1200px;margin:0 auto;padding:70px 6vw;}
  .steps-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;margin-bottom:36px;}
  .steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;position:relative;}
  .step{
    padding:22px 20px 24px;position:relative;border-radius:12px;
    border:1px solid rgba(76,141,255,0.5);
    background:rgba(8,10,14,0.6);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    box-shadow:0 16px 34px rgba(0,0,0,0.5), 0 0 0 1px rgba(76,141,255,0.06) inset;
  }
  .step .num{
    font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--accent);
    position:relative;z-index:1;
  }
  .step h3{font-size:17px;margin-top:14px;}
  .step p{color:var(--ink-soft);font-size:14px;line-height:1.55;margin-top:8px;}
  @media (max-width:820px){
    .steps-grid{grid-template-columns:1fr;gap:16px;}
  }

  /* form */
  .form-section{max-width:1200px;margin:0 auto;padding:20px 6vw 100px;}
  .form-card{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
    padding:44px;max-width:640px;margin:0 auto;
  }
  .form-card h2{font-size:26px;}
  .form-card > p{color:var(--ink-soft);font-size:14px;margin-top:8px;}
  .field{margin-top:20px;}
  .field label{display:block;font-size:13px;font-weight:600;margin-bottom:7px;}
  .field .hint{font-weight:400;color:var(--ink-soft);font-size:12px;}
  .field input[type=text], .field input[type=email], .field input[type=tel], .field textarea{
    width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:8px;
    font-family:'Inter',sans-serif;font-size:15px;background:#12151A;color:var(--ink);
    color-scheme:dark;
  }
  .field input::placeholder, .field textarea::placeholder{color:#5C6675;}
  .field input:focus, .field textarea:focus{border-color:var(--accent);}
  .field textarea{resize:vertical;min-height:100px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media (max-width:520px){.row2{grid-template-columns:1fr;}}

  .dropzone{
    border:1.5px dashed var(--line);border-radius:10px;padding:26px;text-align:center;cursor:pointer;
    background:var(--bg);transition:border-color .15s ease, background .15s ease;
  }
  .dropzone:hover, .dropzone.drag{border-color:var(--accent);background:rgba(76,141,255,0.06);box-shadow:0 0 20px rgba(76,141,255,0.15);}
  .dropzone .fname{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--accent);margin-top:8px;word-break:break-all;}
  .dropzone p{margin:0;color:var(--ink-soft);font-size:14px;}
  .dropzone .browse{color:var(--accent);font-weight:600;}

  .submit-row{margin-top:28px;}
  .submit-row .btn{width:100%;}
  .msg{font-size:13px;margin-top:10px;}
  .msg.error{color:#FF7A7A;}
  .msg.ok{color:var(--accent-2);}

  .success{
    display:none;text-align:center;padding:20px 0;
  }
  .success .signal{margin:8px 0 22px;}
  .success h2{font-size:22px;}
  .success p{color:var(--ink-soft);font-size:14px;margin-top:8px;}

  footer{max-width:1200px;margin:0 auto;padding:30px 6vw 60px;color:var(--ink-soft);font-size:13px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}

  /* modal */
  .overlay{
    position:fixed;inset:0;background:rgba(16,21,26,0.5);display:none;align-items:flex-start;justify-content:center;
    padding:60px 20px;z-index:50;overflow-y:auto;
  }
  .overlay.open{display:flex;}
  .modal{background:var(--surface);border-radius:var(--radius);max-width:720px;width:100%;padding:34px;position:relative;}
  .modal.wide{max-width:960px;}
  .modal .close{position:absolute;top:18px;right:18px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--ink-soft);}
  .modal h2{font-size:20px;margin-bottom:4px;}
  .modal .sub{color:var(--ink-soft);font-size:13px;margin-bottom:20px;}

  .app-row{
    border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin-bottom:12px;
  }
  .app-row .top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;align-items:center;}
  .app-row .name{font-weight:600;font-size:15px;}
  .app-row .date{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-soft);}
  .app-row .meta{font-size:13px;color:var(--ink-soft);margin-top:6px;}
  .app-row .notes{font-size:13px;margin-top:10px;line-height:1.5;background:var(--bg);padding:10px 12px;border-radius:8px;}
  .app-row .actions{margin-top:10px;display:flex;gap:10px;}
  .app-row .actions a, .app-row .actions button{
    font-size:12px;font-family:'JetBrains Mono',monospace;text-decoration:none;color:var(--accent);
    background:none;border:1px solid var(--line);padding:6px 10px;border-radius:100px;cursor:pointer;
  }
  .app-row .actions button.danger{color:#FF7A7A;}
  .empty-state{text-align:center;color:var(--ink-soft);font-size:14px;padding:40px 0;}
</style>
</head>
