<script>
const $ = (id) => document.getElementById(id);

/* ---------- Applicant form ---------- */
let resumeFile = null;

$('dropzone').addEventListener('click', () => $('resumeInput').click());
$('dropzone').addEventListener('keydown', (e) => { if(e.key==='Enter'||e.key===' '){ $('resumeInput').click(); }});
$('dropzone').addEventListener('dragover', (e) => { e.preventDefault(); $('dropzone').classList.add('drag'); });
$('dropzone').addEventListener('dragleave', () => $('dropzone').classList.remove('drag'));
$('dropzone').addEventListener('drop', (e) => {
  e.preventDefault(); $('dropzone').classList.remove('drag');
  const file = e.dataTransfer.files[0];
  if(!file) return;
  // assign the dropped file to the real <input type="file"> so native form submission includes it
  const dt = new DataTransfer();
  dt.items.add(file);
  $('resumeInput').files = dt.files;
  handleFile(file);
});
$('resumeInput').addEventListener('change', (e) => { if(e.target.files[0]) handleFile(e.target.files[0]); });

function handleFile(file){
  if(file.type !== 'application/pdf'){
    $('formMsg').textContent = 'Please upload a PDF file.';
    $('formMsg').className = 'msg error';
    return;
  }
  if(file.size > 10 * 1024 * 1024){
    $('formMsg').textContent = 'That file is a bit large — please upload a PDF under 10MB.';
    $('formMsg').className = 'msg error';
    return;
  }
  resumeFile = file;
  $('fname').textContent = file.name;
  $('formMsg').textContent = '';
}


$('appForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const fullName = $('fullName').value.trim();
  const email = $('email').value.trim();
  const phone = $('phone').value.trim();
  const city = $('city').value.trim();
  const notes = $('notes').value.trim();
  const msg = $('formMsg');

  if(!fullName || !email || !phone || !city){
    msg.textContent = 'Please fill in your name, email, phone, and home town.';
    msg.className = 'msg error';
    return;
  }
  if(!resumeFile){
    msg.textContent = 'Please attach a resume PDF.';
    msg.className = 'msg error';
    return;
  }

  msg.textContent = '';
  $('submitBtn').disabled = true;
  $('submitBtn').textContent = 'Sending…';

  try{
    const formData = new FormData();
    formData.append('fullName', fullName);
    formData.append('email', email);
    formData.append('phone', phone);
    formData.append('homeTown', city);
    formData.append('notes', notes);
    formData.append('resume', resumeFile); // real file attachment
    formData.append('_subject', 'New field rep application — ' + fullName);

    const res = await fetch('https://formspree.io/f/mbdnglgv', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: formData
    });

    if(!res.ok){
      let detail = 'HTTP ' + res.status;
      try{
        const data = await res.json();
        if(data && data.errors && data.errors.length) detail = data.errors.map(er => er.message).join(', ');
        else if(data && data.error) detail = data.error;
      }catch(parseErr){ /* not JSON */ }
      throw new Error(detail);
    }

    $('formWrap').style.display = 'none';
    $('successWrap').style.display = 'block';
    $('successName').textContent = "Thanks, " + fullName.split(' ')[0] + " — we've got your application.";
  }catch(err){
    console.error(err);
    const detail = (err && err.message) || 'unknown error';
    msg.textContent = 'Something went wrong sending your application: ' + detail + '.';
    msg.className = 'msg error';
    $('submitBtn').disabled = false;
    $('submitBtn').textContent = 'Submit application';
  }
});


</script>
</div>
</body>
</html>
